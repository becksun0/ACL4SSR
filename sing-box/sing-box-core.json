{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {"tag": "local", "type": "local", "prefer_go": true},
      {"tag": "ali", "type": "https", "server": "223.5.5.5"},
      {"tag": "tx", "type": "https", "server": "doh.pub", "domain_resolver": "hosts"},
      {"tag": "google", "type": "https", "server": "8.8.8.8", "detour": "默认代理"},
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16"},
      {"type": "hosts", "tag": "hosts", "predefined": {"doh.pub": ["1.12.12.21", "120.53.53.53"]}}
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"clash_mode": "Direct", "server": "ali"},
      {"clash_mode": "Global", "server": "fakeip"},
      {"rule_set": ["fakeipfilter-cn", "geosite-cn", "geosite-microsoft@cn", "geosite-apple@cn", "geosite-private"], "server": "ali"},
      {"rule_set": "fakeipfilter-!cn", "server": "google"},
      {"type": "logical", "mode": "and", "rules": [{"query_type": ["A", "AAAA"]}, {"rule_set": "geosite-geolocation-!cn", "invert": true}], "action": "evaluate", "server": "google", "client_subnet": "223.5.5.0/24","timeout": "2s"},
      {"match_response": true, "rule_set": "geoip-cn", "server": "ali"},
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "google",
    "strategy": "prefer_ipv4",
    "cache_capacity": 8192,
    "optimistic": {"enabled": true},
    "reverse_mapping": true
  },
  "outbounds": [
    {"tag": "默认代理", "type": "selector", "outbounds": ["自动选择", "手动选择", "直连", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "{all}"]},
    {"tag": "手动选择", "type": "selector", "outbounds": ["{all}"], "filter": [{"action": "exclude", "keywords": ["网站|流量|地址|剩余|过期|免费|时间|有效|Traffic|ExpireDate|GB|Expire Date"]}]},
    {"tag": "自动选择", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "exclude", "keywords": ["官网|到期时间|剩余|流量|套餐|免费|订阅|全球直连|GB|Expire Date|Traffic|Expire Date"]}], "interval": "3m", "tolerance": 50},
    {"tag": "YouTube", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连"]},
    {"tag": "Google", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "GitHub", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "Telegram", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "Ai", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "Spotify", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "TikTok", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "Twitter", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连", "{all}"]},
    {"tag": "Netflix", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连"]},
    {"tag": "Wallet", "type": "selector", "outbounds": ["默认代理", "自动选择", "手动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "直连"]},
    {"tag": "Nvidia", "type": "selector", "outbounds": ["默认代理", "自动选择", "香港节点", "韩国节点", "狮城节点", "美国节点", "直连"]},
    {"tag": "PUBG", "type": "selector", "outbounds": ["{all}"]},
    {"tag": "Microsoft", "type": "selector", "outbounds": [ "香港节点", "美国节点", "直连", "{all}"]},
    {"tag": "Apple", "type": "selector", "outbounds": ["香港节点", "美国节点", "直连", "{all}"]},
    {"tag": "漏网之鱼", "type": "selector", "outbounds": ["直连", "{all}"]},
    {"tag": "香港节点", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇭🇰|HK|hk|香港|港|HongKong"]}, {"action": "exclude", "keywords": ["免费"]}], "interval": "3m", "tolerance": 50},
    {"tag": "台湾节点", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇹🇼|台|新北|彰化|TW|Taiwan|TPE|KHH"]}, {"action": "exclude", "keywords": ["免费"]}], "interval": "3m", "tolerance": 50},
    {"tag": "韩国节点", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇰🇷|KR|Korea|KOR|Seoul|首尔|春川|韩|韓|ICN"]}, {"action": "exclude", "keywords": ["免费"]}], "interval": "3m", "tolerance": 50},
    {"tag": "日本节点", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇯🇵|JP|jp|日本|日|Japan"]}, {"action": "exclude", "keywords": ["免费"]}], "interval": "3m", "tolerance": 50},
    {"tag": "狮城节点", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇸🇬|新加坡|坡|狮城|SG|Singapore"]}, {"action": "exclude", "keywords": ["免费"]}], "interval": "3m", "tolerance": 50},
    {"tag": "美国节点", "type": "urltest", "outbounds": ["{all}"], "filter": [{"action": "include", "keywords": ["🇺🇸|US|us|美国|美|United States"]}, {"action": "exclude", "keywords": ["AUS|RUS|免费"]}], "interval": "3m", "tolerance": 50},
    {"tag": "GLOBAL", "type": "selector", "outbounds": ["直连", "默认代理", "手动选择", "香港节点", "台湾节点", "韩国节点", "日本节点", "狮城节点", "美国节点", "{all}"]},
    {"tag": "直连", "type": "direct", "domain_resolver": "ali"}
  ],
  "http_clients": [
    {"tag": "直连下载", "detour": "直连"}
  ],
  "route": {
    "rules": [
      {"type": "logical", "mode": "and", "rules": [{"port": [53, 853], "invert": true}, {"clash_mode": "Global", "invert": true}, {"type": "logical", "mode": "or", "rules": [{"ip_is_private": true}, {"rule_set": "geoip-cn"}]}], "action": "bypass"},
      {"type": "logical", "mode": "or", "rules": [{"domain_suffix": "push.apple.com"}, {"rule_set": "geoip-telegram"}], "invert": true, "action": "sniff", "sniffer": ["http", "tls", "stun", "quic", "dns"], "timeout": "100ms"},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},
      {"ip_is_private": true, "outbound": "直连"},
      {"type": "logical", "mode": "or", "rules": [{"port": 853}, {"protocol": ["stun", "quic"]}], "action": "reject", "no_drop": true},
      {"network": "icmp", "action": "resolve"},
      {"network": "icmp", "outbound": "直连"},
      {"clash_mode": "Direct", "outbound": "直连"},
      {"clash_mode": "Global", "outbound": "GLOBAL"},
      {"rule_set": "geosite-private", "outbound": "直连"},
      {"rule_set": "geosite-myproxy", "outbound": "手动选择"},
      {"rule_set": "geosite-mydirect", "outbound": "直连"},
      {"rule_set": "geosite-category-ai-!cn", "outbound": "Ai"},
      {"rule_set": "geosite-youtube", "outbound": "YouTube"},
      {"rule_set": "geosite-google", "outbound": "Google"},
      {"rule_set": "geosite-github", "outbound": "GitHub"},
      {"rule_set": "geosite-microsoft@cn", "outbound": "直连"},
      {"rule_set": "geosite-microsoft", "outbound": "Microsoft"},
      {"rule_set": "geoip-apple@cn", "outbound": "直连"},
      {"rule_set": "geoip-apple", "outbound": "Apple"},
      {"rule_set": "geosite-telegram", "outbound": "Telegram"},
      {"rule_set": "geosite-spotify", "outbound": "Spotify"},
      {"rule_set": "geosite-tiktok", "outbound": "TikTok"},
      {"rule_set": "geosite-twitter", "outbound": "Twitter"},
      {"rule_set": "geosite-netflix", "outbound": "Netflix"},
      {"rule_set": "geosite-paypal", "outbound": "Wallet"},
      {"rule_set": "geosite-binance", "outbound": "Wallet"},
      {"rule_set": "geosite-okx", "outbound": "Wallet"},
      {"rule_set": "geosite-category-cryptocurrency", "outbound": "Wallet"},
      {"rule_set": "geosite-nvidia", "outbound": "Nvidia"},
      {"rule_set": "geosite-pubg", "outbound": "PUGB"},
      {"rule_set": "geosite-cn", "outbound": "直连"},
      {"rule_set": "geosite-geolocation-!cn", "outbound": "默认代理"},
      {"inbound": "mixed-in", "action": "resolve"},
      {"rule_set": "geoip-google", "outbound": "Google"},
      {"rule_set": "geoip-telegram", "outbound": "Telegram"},
      {"rule_set": "geoip-twitter", "outbound": "Twitter"},
      {"rule_set": "geoip-cn", "outbound": "直连"}
    ],
    "rule_set": [
      {"tag": ["fakeipfilter-cn", "fakeipfilter-!cn"], "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json"},
      {"tag": "geosite-myproxy", "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/becksun0/ACL4SSR/refs/heads/main/sing-box/myproxy.json"},
      {"tag": "geosite-mydirect", "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/becksun0/ACL4SSR/refs/heads/main/sing-box/mydirect.json"},
      {"tag": ["geosite-category-ai-!cn", "geosite-youtube", "geosite-google", "geosite-github", "geosite-onedrive", "geosite-microsoft", "geosite-microsoft@cn","geosite-apple", "geosite-apple@cn", "geosite-telegram", "geosite-spotify", "geosite-tiktok", "geosite-twitter", "geosite-netflix", "geosite-paypal", "geosite-binance", "geosite-okx", "geosite-category-cryptocurrency", "geosite-nvidia", "geosite-pubg", "geosite-cn", "geosite-geolocation-!cn", "geosite-private"], "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"},
      {"tag": "geoip-telegram", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs"},
      {"tag": "geoip-google",  "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/google.srs"},
      {"tag": "geoip-twitter", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/twitter.srs"},
      {"tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"}
    ],
    "final": "漏网之鱼",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "ali"}
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "passwd",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "secret": "passwd",
      "default_mode": "Rule"
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}
